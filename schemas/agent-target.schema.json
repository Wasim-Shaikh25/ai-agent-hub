{
  "title": "AgentTargetConfig",
  "description": "Schema for an agent target configuration in the AI Agent Hub.",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "extensionId",
    "enabled",
    "targets",
    "autoSync"
  ],
  "definitions": {
    "targetLocationConfig": {
      "type": "object",
      "required": ["enabled", "path", "fileLayout", "fileExtension"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "fileLayout": {
          "type": "string",
          "enum": ["flat", "subfolder"]
        },
        "fileExtension": {
          "type": "string",
          "enum": ["md", "instructions-md", "mdc", "prompt-md"]
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "extensionId": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "targets": {
      "type": "object",
      "required": ["skill", "rule", "hook", "workflow", "persona"],
      "properties": {
        "skill": { "$ref": "#/definitions/targetLocationConfig" },
        "rule": { "$ref": "#/definitions/targetLocationConfig" },
        "hook": { "$ref": "#/definitions/targetLocationConfig" },
        "workflow": { "$ref": "#/definitions/targetLocationConfig" },
        "persona": { "$ref": "#/definitions/targetLocationConfig" }
      },
      "additionalProperties": false
    },
    "autoSync": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
