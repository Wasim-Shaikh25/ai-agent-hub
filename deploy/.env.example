# Copy to .env before `docker compose up`. All values have safe local defaults.

# Stable dev API key seeded on first boot (copy into agent MCP config / curl).
DEV_API_KEY=hub_dev_localkey

# "local" = offline embeddings (no keys needed). Switch to "litellm" to use
# real embeddings via the gateway (requires OPENAI_API_KEY below).
EMBEDDINGS_PROVIDER=minilm

# Optional provider keys — only needed for real inference / litellm embeddings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature flags
ENABLE_AI_ASSISTANT=false

# OAuth registration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Superadmin application owner (set a strong password in prod)
SUPERADMIN_EMAIL=admin@localhost
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_MOBILE=

# SMTP for superadmin OTP codes (optional — codes are logged to stdout when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
