# hub-server configuration (local dev defaults)
PORT=8080

# Postgres (pgvector). When running the server OUTSIDE docker, use localhost:
#   DATABASE_URL=postgres://hub:hub@localhost:5432/hub
DATABASE_URL=postgres://hub:hub@postgres:5432/hub

REDIS_URL=redis://redis:6379

# LLM gateway (LiteLLM). Master key must match general_settings.master_key
# in deploy/litellm.config.yaml.
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-local-master

# Embeddings provider:
#   local   — offline hash (no deps; lower quality, good for demos)
#   minilm  — real semantic embeddings via all-MiniLM-L6-v2 in-process
#             (needs the optional dep @xenova/transformers; downloads ~30MB once;
#              no Ollama/server). Falls back to "local" if unavailable.
#   litellm — embeddings via the gateway (needs a provider key)
EMBEDDINGS_PROVIDER=local
EMBEDDING_DIM=1536

# Dev convenience: seed an org + this API key on first boot
DEV_SEED=true
DEV_API_KEY=hub_dev_localkey

# Auth / SSO. JWT_SECRET signs session tokens — set a strong value in prod.
JWT_SECRET=dev-secret-change-me
APP_BASE_URL=http://localhost:8080
# SSO_PROVIDER=dev works offline. Switch to "workos" and fill the keys below.
SSO_PROVIDER=dev
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Row-Level Security is installed (migration 005) and non-breaking by default.
RLS_ENABLED=false

# Billing (Stripe) — leave blank to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Privacy & data residency
# STORAGE_MODE: "central" (team-shared on this server) or "local" (per-dev).
STORAGE_MODE=central
LOG_PROMPTS=false
# PII/secret redaction before store + forward. mode: "redact" or "block".
REDACTION_ENABLED=true
REDACTION_MODE=redact

# Semantic cache (opt-in) — return cached completions for similar prompts.
CACHE_ENABLED=false
CACHE_THRESHOLD=0.05
CACHE_TTL_DAYS=7

# Default visibility for new memory: org | project | private
DEFAULT_VISIBILITY=project

# Model used for session summarization + memory extraction (via the gateway).
# Falls back to a deterministic heuristic when no provider is reachable.
SUMMARY_MODEL=gpt-4o-mini

# Memory recency decay (days). 0 disables; higher = slower fade.
MEMORY_HALFLIFE_DAYS=30

# Ops
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=600

# AI assistant feature flag. Set to true only if you want to pay for the
# super-admin operator copilot. End users never see an AI chat either way.
ENABLE_AI_ASSISTANT=false

# OAuth registration (Google / Apple). Leave blank to keep email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Superadmin application owner. Used for the /superadmin-login OTP flow.
# SUPERADMIN_ID is optional; a UUID is generated when not provided.
SUPERADMIN_ID=
SUPERADMIN_EMAIL=admin@localhost
SUPERADMIN_MOBILE=
SUPERADMIN_PASSWORD=change-me

# SMTP for sending superadmin OTP codes. When not configured, codes are printed
# to stdout in dev/test mode so the login flow can still be exercised.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
