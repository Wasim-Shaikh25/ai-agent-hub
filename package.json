{
  "name": "ai-agent-hub",
  "displayName": "AI Agent Hub",
  "description": "A centralized control plane for managing AI agent behavior content and syncing it to configured AI agent targets",
  "version": "0.0.6",
  "publisher": "ai-agent-hub",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:aiAgentHub.open",
    "onCommand:aiAgentHub.setup",
    "onCommand:aiAgentHub.addSkill",
    "onCommand:aiAgentHub.addRule",
    "onCommand:aiAgentHub.addHook",
    "onCommand:aiAgentHub.syncToAgents",
    "onCommand:aiAgentHub.showAgents",
    "onCommand:aiAgentHub.connectServer",
    "onCommand:aiAgentHub.connectAgentsToHub",
    "onCommand:aiAgentHub.pullFromHub",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiAgentHub.open",
        "title": "AI Agent Hub: Open"
      },
      {
        "command": "aiAgentHub.setup",
        "title": "AI Agent Hub: Setup"
      },
      {
        "command": "aiAgentHub.addSkill",
        "title": "AI Agent Hub: Add Skill"
      },
      {
        "command": "aiAgentHub.addRule",
        "title": "AI Agent Hub: Add Rule"
      },
      {
        "command": "aiAgentHub.addHook",
        "title": "AI Agent Hub: Add Hook"
      },
      {
        "command": "aiAgentHub.syncToAgents",
        "title": "AI Agent Hub: Sync to Agents"
      },
      {
        "command": "aiAgentHub.showAgents",
        "title": "AI Agent Hub: Show Configured Agents"
      },
      {
        "command": "aiAgentHub.connectServer",
        "title": "AI Agent Hub: Connect to Server"
      },
      {
        "command": "aiAgentHub.connectAgentsToHub",
        "title": "AI Agent Hub: Connect Agents to Hub (write MCP config)"
      },
      {
        "command": "aiAgentHub.pullFromHub",
        "title": "AI Agent Hub: Pull Content from Hub"
      }
    ],
    "configuration": {
      "title": "AI Agent Hub",
      "properties": {
        "aiAgentHub.autoSync.confirmBeforeSync": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before auto-syncing hub content to configured AI agent targets."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -watch",
    "test": "vitest --run",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wasim-Shaikh25/ai-agent-hub.git"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^3.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}
