{
  "name": "ai-agent-hub",
  "displayName": "AI Agent Hub",
  "description": "A centralized control plane for managing AI behavior content and syncing it to configured AI agent targets",
  "version": "0.0.1",
  "publisher": "ai-agent-hub",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "aiAgentHub.open",
        "title": "AI Agent Hub: Open"
      },
      {
        "command": "aiAgentHub.setup",
        "title": "AI Agent Hub: Setup"
      },
      {
        "command": "aiAgentHub.addSkill",
        "title": "AI Agent Hub: Add Skill"
      },
      {
        "command": "aiAgentHub.addRule",
        "title": "AI Agent Hub: Add Rule"
      },
      {
        "command": "aiAgentHub.addHook",
        "title": "AI Agent Hub: Add Hook"
      },
      {
        "command": "aiAgentHub.syncToAgents",
        "title": "AI Agent Hub: Sync to Agents"
      },
      {
        "command": "aiAgentHub.showAgents",
        "title": "AI Agent Hub: Show Configured Agents"
      }
    ],
    "configuration": {
      "title": "AI Agent Hub",
      "properties": {
        "aiAgentHub.autoSync.confirmBeforeSync": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before auto-syncing hub content to configured AI agent targets."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -watch",
    "test": "vitest --run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.disney.com/WDPR-Lodging/ai-agent-hub.git"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "vitest": "^1.2.0",
    "fast-check": "^3.15.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}
